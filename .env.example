# =============================================================================
# bi-platform — environment variables
# Copy to .env and fill in your values. Never commit .env
# =============================================================================

# --- Snowflake connection ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=STAGING

# --- dbt ---
DBT_TARGET=dev

# --- Airflow (Docker only) ---
# Admin credentials for the Airflow UI (change in production)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
